rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite codes — any signed-in user can read (to join) or create (when making a group)
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // User-to-group index — entry doc IDs are `{userId}_{groupId}`, so users can only
    // touch their own entries. Prevents enumeration of who-is-in-what at scale.
    match /userGroups/{entry} {
      allow read, write: if request.auth != null
        && entry.matches('^' + request.auth.uid + '_.*');
    }

    // Groups
    match /groups/{groupId} {
      // Only members can read the group doc
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));

      // Only members can update (e.g. rename group)
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));

      // Allow create from authenticated users (onboarding creates the group)
      allow create: if request.auth != null;

      // Members sub-collection
      match /members/{memberId} {
        // You can always read your own member doc (so we can check if you're already in)
        // or read any member doc once you're a member
        allow read: if request.auth != null && (
          memberId == request.auth.uid ||
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        );
        // A user can create their own member entry (used for joining via invite link)
        allow create: if request.auth != null && memberId == request.auth.uid;
        allow update: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow delete: if false;
      }

      // Children sub-collection
      match /children/{childId} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }

      // Blocks sub-collection
      match /blocks/{blockId} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
    }
  }
}
